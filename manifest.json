{
  "manifest_version": 3,
  "name": "WordPress Plugin Rating Trends",
  "version": "1.1.1",
  "description": "Shows a 12-month rating trend chart on WordPress.org plugin pages",

  "browser_specific_settings": {
    "gecko": {
      "id": "wp-plugin-rating-trends@presskopp.com",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.wordpress.org/plugins/*"
      ],
      "js": [
        "i18n.js",
        "content.js"
      ]
    }
  ],

  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
